// === Реализация методов сокетов Item ===

bool Item::HasSocket(uint8 slot) const
{
    auto it = m_itemSockets.find(slot);
    return it != m_itemSockets.end();
}

uint32 Item::GetSocketGem(uint8 slot) const
{
    auto it = m_itemSockets.find(slot);
    if (it != m_itemSockets.end())
        return it->second;
    return 0;
}

bool Item::SocketGem(uint8 slot, uint32 gemEntry)
{
    m_itemSockets[slot] = gemEntry;
    ApplySocketBonuses();
    return true;
}

bool Item::UnsocketGem(uint8 slot)
{
    m_itemSockets.erase(slot);
    ApplySocketBonuses();
    return true;
}

void Item::LoadSocketsFromDB(QueryResult result)
{
    if (!result)
        return;
    
    do
    {
        Field* fields = result->Fetch();
        uint8 slot = fields[0].Get<uint8>();
        uint32 gemEntry = fields[1].Get<uint32>();
        m_itemSockets[slot] = gemEntry;
    } while (result->NextRow());
    
    m_itemSocketsLoaded = true;
}

void Item::SaveSocketsToDB()
{
    if (!m_itemSocketsLoaded)
        return;
    
    WorldDatabase.Execute("DELETE FROM character_item_sockets WHERE item_guid = " + std::to_string(GetGUIDLow()));
    
    for (auto const& socket : m_itemSockets)
    {
        WorldDatabase.Execute("INSERT INTO character_item_sockets (character_guid, item_guid, slot, gem_entry) VALUES ("
            + std::to_string(GetOwnerGUID()) + ", "
            + std::to_string(GetGUIDLow()) + ", "
            + std::to_string(socket.first) + ", "
            + std::to_string(socket.second) + ")");
    }
}

void Item::ApplySocketBonuses()
{
    // Здесь применяются бонусы от камней к характеристикам предмета
    // В реальной реализации нужно модифицировать ItemModifiedStats
