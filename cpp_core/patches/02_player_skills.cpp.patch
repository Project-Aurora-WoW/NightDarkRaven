// === Реализация методов NightRaven навыков ===

void Player::LoadNightRavenSkills(QueryResult result)
{
    if (!result)
        return;
    
    do
    {
        Field* fields = result->Fetch();
        uint32 skillId = fields[0].Get<uint32>();
        uint32 skillValue = fields[1].Get<uint32>();
        m_nightRavenSkills[skillId] = skillValue;
    } while (result->NextRow());
    
    m_nightRavenSkillsLoaded = true;
}

uint32 Player::GetNightRavenSkillValue(uint32 skillId) const
{
    auto it = m_nightRavenSkills.find(skillId);
    if (it != m_nightRavenSkills.end())
        return it->second;
    return 0;
}

void Player::SetNightRavenSkillValue(uint32 skillId, uint32 value)
{
    m_nightRavenSkills[skillId] = value;
}

void Player::NightRavenSkillUp(uint32 skillId, uint32 amount)
{
    uint32 current = GetNightRavenSkillValue(skillId);
    uint32 maxLevel = 375; // Максимальный уровень навыка
    uint32 newValue = std::min(current + amount, maxLevel);
    SetNightRavenSkillValue(skillId, newValue);
    
    // Отправить обновление навыка клиенту (если навык отображается в интерфейсе)
    // Для кастомных навыков может потребоваться dodatковый пакет
}

bool Player::HasNightRavenSkill(uint32 skillId) const
{
    return m_nightRavenSkills.find(skillId) != m_nightRavenSkills.end();
}

void Player::SaveNightRavenSkillsToDB()
{
    if (!m_nightRavenSkillsLoaded)
        return;
    
    WorldDatabase.Execute("DELETE FROM character_skills WHERE guid = " + std::to_string(GetGUIDLow()));
    
    for (auto const& skill : m_nightRavenSkills)
    {
        WorldDatabase.Execute("INSERT INTO character_skills (guid, skill_id, value) VALUES (" 
            + std::to_string(GetGUIDLow()) + ", " 
            + std::to_string(skill.first) + ", " 
            + std::to_string(skill.second) + ")");
    }
}