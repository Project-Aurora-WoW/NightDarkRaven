// === Реализация методов соло-режима ===

bool Unit::IsSoloModeEnabled() const
{
    return m_soloModeEnabled;
}

void Unit::SetSoloModeEnabled(bool enabled)
{
    m_soloModeEnabled = enabled;
}

float Unit::GetSoloHealthMultiplier() const
{
    // -40% здоровья для мобов в соло-режиме (0.60 = 60%)
    return 0.60f;
}

float Unit::GetSoloDamageMultiplier() const
{
    // -30% урона для мобов в соло-режиме (0.70 = 70%)
    return 0.70f;
}

void Unit::ApplySoloModifiers()
{
    if (!IsSoloModeEnabled())
        return;
    
    // Уменьшаем текущее и maximale здоровье
    uint32 maxHealth = GetMaxHealth();
    uint32 newMaxHealth = uint32(maxHealth * GetSoloHealthMultiplier());
    SetMaxHealth(newMaxHealth);
    SetHealth(std::min(GetHealth(), newMaxHealth));
    
    // Уменьшаем урон (применяется при расчете урона в CalcDamage)
}